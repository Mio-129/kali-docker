{
  "name": "Kali Docker + Masaustu (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "forwardPorts": [6080, 5901, 9443],
  "portsAttributes": {
    "6080": {
      "label": "Kali Masaustu (noVNC)",
      "onAutoForward": "openPreview"
    },
    "5901": {
      "label": "Kali VNC",
      "onAutoForward": "silent"
    },
    "9443": {
      "label": "Portainer - opsiyonel Docker paneli",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/setup-kali.sh",
  "postStartCommand": "bash .devcontainer/setup-kali.sh --start-only",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "terminal.integrated.profiles.linux": {
          "Kali Linux": {
            "path": "bash",
            "args": ["-lc", "kali"],
            "icon": "terminal-bash"
          }
        }
      }
    }
  }
}
